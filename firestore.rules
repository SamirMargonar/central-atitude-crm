rules_version = '2';

// ==============================================================
// CANDIDATA OFICIAL CONSOLIDADA — AINDA NÃO PUBLICADA
// ==============================================================
//
// Este arquivo consolida, em um único lugar, todas as decisões
// arquiteturais já validadas isoladamente ao longo desta sessão de
// trabalho, cada uma no Firestore Local Emulator, nunca publicadas:
//
//   1. usuarios/{uid} — proteção do Admin (Coordenador não pode
//      alterar/bloquear/desbloquear/promover-se a Admin).
//   2. leads/{leadId} — visibilidade (dono / fila Recebidos),
//      criação, edição, "assumir" via responsavelUid.
//   3. leads/{leadId}/eventos/{eventoId} — decisão da fila:
//      leitura da timeline de um lead na fila Recebidos = ALLOW
//      (possoVerLead); criação de evento nesse lead antes de
//      assumir = DENY (podeAgirNoLead). Validada isoladamente em
//      firestore-v2-decisao-eventos.rules.
//   4. visitas/{visitaId} — visibilidade e operação por turno da
//      recepcionista (turno normal e atravessando meia-noite),
//      acesso completo para admin/coordenador. Validada em
//      firestore-v3-visitas.rules.
//   5. Hardening de auditoria dos campos de rastreabilidade da
//      visita (confirmadoPor/confirmadoPorNome/confirmadoEm,
//      atendidoPor/atendidoPorNome/atendidoEm) — exige que o valor
//      gravado represente o próprio chamador, e que timestamps
//      sejam gravados via serverTimestamp() real (comparados contra
//      request.time). Validada em firestore-v4-visitas-auditoria.rules.
//   6. Comparecimento cross-turno — permite que uma recepcionista
//      que está operando (dentro do próprio turno) uma visita de um
//      Lead de outro responsável grave SOMENTE os campos
//      estritamente necessários do fluxo COMPARECEU/NAO_COMPARECEU
//      no Lead e nos eventos da timeline — nunca responsavelUid,
//      responsavel ou consultora, nunca outro campo, nunca outro
//      valor de etapa além do exigido por cada ramo. Validada em
//      firestore-v6-comparecimento-cross-turno.rules (145 testes:
//      116 da suíte geral + 29 específicos deste cenário).
//   7. eventoDeComparecimentoValido() passa a aceitar também o tipo
//      'WHATSAPP_LIVRE', só para cobrir o envio da mensagem de
//      confirmação de visita pelo WhatsApp (que sempre carrega
//      dados.visitaId e prova o vínculo com a visita dentro do
//      turno) — mesmo cenário cross-turno do item 6, agora também
//      para esse evento. Não abre WhatsApp Livre solto (sem visita)
//      para não-donos do Lead.
//   8. Consulta de leads entre recepcionistas — possoVerLead()
//      passa a liberar LEITURA (get/list de leads/{leadId}, e por
//      tabela a leitura de leads/{leadId}/eventos/{eventoId}, que
//      reusa esta mesma função) para QUALQUER recepcionista, em
//      QUALQUER lead. Mudança isolada à leitura: podeAgirNoLead()
//      e podeEditarLead() (usadas por allow update/delete e pela
//      criação de eventos) não chamam possoVerLead() e continuam
//      exigindo dono/admin/coordenador, sem nenhuma alteração.
//
//   9. Transferência em massa de leads / troca de dono — SOMENTE duas
//      identidades fixas (UIDs reais do Firebase Authentication,
//      conferidos em produção em 2026-10-10) podem trocar o dono de um
//      lead que já tem dono, individualmente ou em massa. Destino normal
//      = recepcionista ATIVA. Reversão de uma operação real é a única
//      exceção que aceita destino inativo, e só devolvendo ao dono
//      anterior registrado em item de auditoria. Coleção
//      transferenciasEmMassa (+ itens) = trilha de auditoria; uma
//      reversão por operação (ID 'rev-<opId>'). Excluir lead e criar
//      lead atribuído a OUTRA pessoa também são restritos aos
//      autorizados (fecha o contorno "apagar e recriar").
//
//  10. Assumir lead da fila só em nome de si mesmo: UID real e o nome do
//      próprio cadastro (antes só o UID era conferido — dava para gravar
//      o nome de outra pessoa). Auditoria da transferência em massa com
//      campos descritivos conferidos (anterior, nomes, evento) e contadores
//      declarados coerentes; o que as Rules NÃO conseguem conferir (lista
//      de visitas do item, contagem real de itens) está documentado junto
//      às funções e NÃO é usado para decidir nada.
//
// O código React correspondente (responsavelUid em Leads.jsx:
// assumirLead(), e ultimaVisitaId em Agenda/DetalhesVisita.jsx)
// já foi implementado e commitado separadamente.
//
// Dependência conhecida e aceita: os valores 3 (VISITA) e 4
// (NEGOCIACAO) usados no comparecimento cross-turno estão fixos
// aqui, replicando core/LeadFlow.js:ETAPAS — não há vínculo
// automático entre os dois; se o enum mudar, esta Rule precisa ser
// atualizada junto.
//
// AINDA NÃO PUBLICADA. Este arquivo vive fora do repositório do
// projeto, no scratchpad, e não foi copiado para dentro dele nem
// enviado ao Firebase.
// ==============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // FUNÇÕES AUXILIARES
    // ==========================================================

    function estaLogado() {
      return request.auth != null;
    }

    function ehEuMesmo(uid) {
      return estaLogado() && request.auth.uid == uid;
    }

    function perfilDoChamador() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function nomeDoChamador() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nome;
    }

    function ehAdmin() {
      return estaLogado() && perfilDoChamador() == 'admin';
    }

    function ehCoordenador() {
      return estaLogado() && perfilDoChamador() == 'coordenador';
    }

    // Uma única leitura de usuarios/{uid} (antes eram até duas: ehAdmin()
    // e ehCoordenador() liam o mesmo documento). Mesma semântica; reduz
    // as chamadas get() contadas contra os limites de 10 por operação e
    // 20 por transação/lote.
    function ehAdminOuCoordenador() {
      return estaLogado() && perfilDoChamador() in ['admin', 'coordenador'];
    }

    function ehRecepcionista() {
      return estaLogado() && perfilDoChamador() == 'recepcionista';
    }

    function perfilValido(dados) {
      return dados.perfil in ['admin', 'coordenador', 'recepcionista'];
    }

    // ==========================================================
    // USUARIOS/{UID}
    // ==========================================================

    match /usuarios/{uid} {

      allow get: if ehEuMesmo(uid) || ehAdminOuCoordenador();

      allow list: if ehAdminOuCoordenador();

      allow create: if ehAdminOuCoordenador()
                    && perfilValido(request.resource.data)
                    && (ehAdmin() || request.resource.data.perfil != 'admin');

      allow update: if ehAdminOuCoordenador()
                    && perfilValido(request.resource.data)
                    && (
                         ehAdmin()
                         || (resource.data.perfil != 'admin' && request.resource.data.perfil != 'admin')
                       );

      allow delete: if false;

    }

    // ==========================================================
    // FUNÇÕES DE LEADS
    // ==========================================================

    function valorOuVazio(dados, chave) {
      return chave in dados ? dados[chave] : '';
    }

    function leadSemResponsavel(dados) {
      return valorOuVazio(dados, 'responsavelUid') == ''
          && valorOuVazio(dados, 'consultora') == ''
          && valorOuVazio(dados, 'responsavel') == '';
    }

    function leadNaFilaRecebidos(dados) {
      return dados.etapa == 0
          && dados.assumido == false
          && leadSemResponsavel(dados);
    }

    function souDonoDoLead(dados) {
      return estaLogado() && (
           valorOuVazio(dados, 'responsavelUid') == request.auth.uid
        || (valorOuVazio(dados, 'consultora') != '' && valorOuVazio(dados, 'consultora') == nomeDoChamador())
        || (valorOuVazio(dados, 'responsavel') != '' && valorOuVazio(dados, 'responsavel') == nomeDoChamador())
      );
    }

    // 'possoVerLead' passou a liberar LEITURA (get/list, e por
    // tabela a leitura de leads/{leadId}/eventos, que reusa esta
    // mesma função) para QUALQUER recepcionista, em QUALQUER
    // lead — consulta operacional (ex.: cliente na recepção que
    // já foi atendido por outra recepcionista). Isto NÃO afeta
    // nenhuma escrita: podeAgirNoLead()/podeEditarLead() (usadas
    // por allow update/delete e pela criação de eventos) não
    // chamam possoVerLead() e continuam exigindo dono/admin/
    // coordenador, sem nenhuma alteração.
    function possoVerLead(dados) {
      return ehAdminOuCoordenador()
          || souDonoDoLead(dados)
          || (ehRecepcionista() && leadNaFilaRecebidos(dados))
          || ehRecepcionista();
    }

    function podeAgirNoLead(dados) {
      return ehAdminOuCoordenador() || souDonoDoLead(dados);
    }

    function propriedadeMudou(antes, depois) {
      return valorOuVazio(antes, 'responsavelUid') != valorOuVazio(depois, 'responsavelUid')
          || valorOuVazio(antes, 'consultora')      != valorOuVazio(depois, 'consultora')
          || valorOuVazio(antes, 'responsavel')      != valorOuVazio(depois, 'responsavel');
    }

    // ASSUMIR lead da fila (desktop: Leads.jsx; mobile: assumirLeadMobile.js).
    // O lead precisa estar sem responsável e quem assume só pode gravar a
    // PRÓPRIA identidade: UID real do Authentication (request.auth.uid) e o
    // nome do próprio cadastro (usuarios/{uid}.nome) em 'responsavel' e
    // 'consultora'. Antes só o UID era conferido, então dava para assumir
    // um lead gravando o NOME de outra pessoa (que passava a ser dona por
    // nome — ver souDonoDoLead). Os campos de auditoria da assunção
    // (assumidoPor / assumidoPorUid), quando enviados, também precisam ser
    // os do próprio chamador.
    function ehAssumirValido(antes, depois) {
      return leadSemResponsavel(antes)
          && valorOuVazio(depois, 'responsavelUid') == request.auth.uid
          && valorOuVazio(depois, 'responsavel') == nomeDoChamador()
          && valorOuVazio(depois, 'consultora') == nomeDoChamador()
          && assumidoPorConfere(depois);
    }

    function assumidoPorConfere(depois) {
      return (!('assumidoPorUid' in depois) || depois.assumidoPorUid == request.auth.uid)
          && (!('assumidoPor' in depois) || depois.assumidoPor == nomeDoChamador());
    }

    // ----------------------------------------------------------
    // TROCA DE DONO DE LEAD (transferência individual ou em massa)
    //
    // Só as duas identidades abaixo — comparadas pelo UID REAL do
    // Firebase Authentication (request.auth.uid), nunca por nome nem
    // por qualquer campo gravado em usuarios/{uid}, que um
    // coordenador consegue editar. Para mudar a lista é preciso
    // publicar novas Rules (nenhum usuário consegue se autorizar).
    //   jDYvHOHYROec7Gr8DAFASz0ZfUy2 — Samir (administrador)
    //   jLZDUG9DtlZtRhBR04pxyMUlWxj2 — Naykison (coordenador)
    // ----------------------------------------------------------

    function ehAutorizadoATransferirCarteira() {
      return estaLogado()
          && request.auth.uid in ['jDYvHOHYROec7Gr8DAFASz0ZfUy2', 'jLZDUG9DtlZtRhBR04pxyMUlWxj2']
          && ehAdminOuCoordenador();
    }

    // Destino precisa ser recepcionista e os 3 campos de dono do lead
    // precisam coincidir com o cadastro dela.
    function destinoRecepcionistaConfere(depois) {
      let alvo = get(/databases/$(database)/documents/usuarios/$(depois.responsavelUid)).data;
      return alvo.perfil == 'recepcionista'
          && depois.responsavel == alvo.nome
          && depois.consultora == alvo.nome;
    }

    // Transferência NORMAL: destino precisa estar ATIVO. (Uma única
    // leitura do cadastro do destino.)
    function transferenciaNormalValida(depois) {
      let alvo = get(/databases/$(database)/documents/usuarios/$(depois.responsavelUid)).data;
      return alvo.perfil == 'recepcionista'
          && alvo.get('ativo', true) != false
          && depois.responsavel == alvo.nome
          && depois.consultora == alvo.nome;
    }

    // REVERSÃO: única exceção que aceita destino inativo. Só vale se, na
    // MESMA transação, existir o item de auditoria da reversão e se o
    // item da transferência original provar que este lead saiu de
    // depois.responsavelUid e está agora com antes.responsavelUid.
    //
    // PROTEÇÃO CONTRA REVERTER LEAD TRABALHADO (M2), com os dados que as
    // Rules enxergam, sem documentos novos para o update do lead (o item
    // original e a operação já eram lidos; o item de uma reversão lê o
    // item original — o mesmo documento — uma vez):
    //   - o lead continua marcado pela transferência original
    //     (ultimaTransferenciaEmMassaId == op.reverteOpId);
    //   - o lead NÃO foi gravado desde a transferência: o atualizadoEm
    //     dele é o instante do item original (a transferência grava os
    //     dois com request.time — ver itemCorrespondeATransferencia —, e
    //     atualizarLead() regrava atualizadoEm em toda edição do app);
    //   - a etapa é a mesma do item original (etapa gravada no item é
    //     conferida contra o lead na criação do item);
    //   - a reversão só muda campos de dono (+ visita.consultor).
    //
    // O QUE AS RULES NÃO CONSEGUEM COMPROVAR (continua só no serviço):
    //   - eventos da timeline sem gravação no lead (observações,
    //     WhatsApp): não há como consultá-los aqui;
    //   - gravações no lead que não passem por atualizarLead() (hoje só o
    //     "assumir" da fila, que muda o dono e portanto já impede a
    //     reversão);
    //   - a correção da restauração das VISITAS (consultoraId de cada
    //     visita): as Rules só garantem que quem muda é autorizado;
    //   - a veracidade dos campos de auditoria que o cliente grava no
    //     item (anterior, visitasAtualizadas).
    function reversaoDeLeadValida(leadId, antes, depois) {
      let opId = depois.ultimaTransferenciaEmMassaId;
      let op = getAfter(/databases/$(database)/documents/transferenciasEmMassa/$(opId)).data;
      let itemRev = /databases/$(database)/documents/transferenciasEmMassa/$(opId)/itens/$(leadId);
      let itemOriginal = /databases/$(database)/documents/transferenciasEmMassa/$(op.reverteOpId)/itens/$(leadId);
      return op.tipo == 'reversao'
          && op.status == 'em_andamento'
          && op.origemUid == antes.responsavelUid
          && op.destinoUid == depois.responsavelUid
          && existsAfter(itemRev)
          && exists(itemOriginal)
          && itemOriginalConfere(itemOriginal, op, antes, depois)
          && soCamposDeDonoMudaram(antes, depois)
          && destinoRecepcionistaConfere(depois);
    }

    // Só é chamada depois de exists(itemOriginal): uma única leitura do
    // item da transferência original.
    function itemOriginalConfere(itemOriginal, op, antes, depois) {
      let original = get(itemOriginal).data;
      return original.paraUid == antes.responsavelUid
          && original.deUid == depois.responsavelUid
          && ('ultimaTransferenciaEmMassaId' in antes)
          && antes.ultimaTransferenciaEmMassaId == op.reverteOpId
          && ('atualizadoEm' in antes)
          && antes.atualizadoEm == original.criadoEm
          && etapaDoLead(antes) == original.etapa;
    }

    function etapaDoLead(dados) {
      return 'etapa' in dados ? dados.etapa : null;
    }

    // A reversão não pode ser usada para alterar nada além do dono (e
    // do nome do consultor dentro do espelho da visita).
    function soCamposDeDonoMudaram(antes, depois) {
      let alterados = depois.diff(antes).affectedKeys();
      return alterados.hasOnly(['responsavelUid', 'responsavel', 'consultora',
                                'ultimaTransferenciaEmMassaId', 'atualizadoEm', 'visita'])
          && (!('visita' in alterados)
              || depois.visita.diff(antes.visita).affectedKeys().hasOnly(['consultor']));
    }

    // Os dois autorizados são avaliados primeiro (para quem não está na
    // lista, ehAutorizadoATransferirCarteira() não lê nenhum documento:
    // o UID é comparado antes do perfil).
    function podeEditarLead(leadId, antes, depois) {
      return (ehAutorizadoATransferirCarteira()
              && (!propriedadeMudou(antes, depois)
                  || transferenciaNormalValida(depois)
                  || reversaoDeLeadValida(leadId, antes, depois)
                  || ehAssumirValido(antes, depois)))
          || (ehAdminOuCoordenador()
              && (!propriedadeMudou(antes, depois)
                  || ehAssumirValido(antes, depois)))
          || (souDonoDoLead(antes) && !propriedadeMudou(antes, depois))
          || (ehRecepcionista() && ehAssumirValido(antes, depois));
    }

    // ----------------------------------------------------------
    // PROPRIEDADE INICIAL DE UM LEAD NOVO (create)
    //
    // Fecha o contorno "apagar e recriar": quem não é autorizado só
    // cria lead SEM responsável (fila) ou em nome de si mesmo
    // (UID e nomes = o próprio chamador). Cobre os fluxos reais:
    // cadastro normal (admin/coordenador → fila; recepcionista → ela
    // mesma) e Cadastro Gerencial (o próprio gestor). Atribuir um lead
    // novo a OUTRA pessoa é troca de carteira: só os autorizados.
    // ----------------------------------------------------------

    function propriedadeInicialValida(dados) {
      return leadSemResponsavel(dados)
          || (valorOuVazio(dados, 'responsavelUid') == request.auth.uid
              && valorOuVazio(dados, 'responsavel') in ['', nomeDoChamador()]
              && valorOuVazio(dados, 'consultora') in ['', nomeDoChamador()]);
    }

    // ----------------------------------------------------------
    // COMPARECIMENTO CROSS-TURNO
    //
    // Permite que uma recepcionista que NÃO é dona do Lead, mas que
    // está operando (dentro do próprio turno) uma visita realmente
    // vinculada a este Lead, grave SOMENTE os campos do fluxo de
    // comparecimento — nunca responsavelUid/responsavel/consultora,
    // nunca outro campo, nunca outro valor de etapa além do exato
    // esperado por cada ramo.
    //
    // A ligação lead<->visita é provada via get() na visita cujo ID
    // o próprio payload já carrega (ultimaVisitaId no ramo
    // COMPARECEU, alertaNaoCompareceuVisitaId no ramo
    // NAO_COMPARECEU — ambos já fazem parte do payload real do app).
    //
    // Dependência conhecida e aceita: os valores 3 (VISITA) e 4
    // (NEGOCIACAO) estão fixos aqui, replicando core/LeadFlow.js:
    // ETAPAS. Se esse enum mudar no futuro, esta Rule precisa ser
    // atualizada junto — não há vínculo automático entre os dois.
    // ----------------------------------------------------------

    function visitaLigadaAoLeadDentroDoTurno(leadId, visitaId) {
      let visita = get(/databases/$(database)/documents/visitas/$(visitaId)).data;
      return visita.leadId == leadId && visitaDentroDoTurnoDoChamador(visita);
    }

    function podeAtualizarLeadViaComparecimento(leadId, antes, depois) {
      let alterados = depois.diff(antes).affectedKeys();

      let camposCompareceuOk =
        alterados.hasOnly(['etapa', 'ultimoAtendimento', 'alertaNaoCompareceu', 'ultimaVisitaId', 'atualizadoEm'])
        && depois.etapa == 4
        && ('ultimaVisitaId' in depois)
        && visitaLigadaAoLeadDentroDoTurno(leadId, depois.ultimaVisitaId);

      let camposNaoCompareceuOk =
        alterados.hasOnly(['etapa', 'ultimoAtendimento', 'alertaNaoCompareceu', 'alertaNaoCompareceuEm', 'alertaNaoCompareceuVisitaId', 'pendenciaComercial', 'atualizadoEm'])
        && depois.etapa == 3
        && depois.pendenciaComercial == 'NOVO_CONTATO_NAO_COMPARECIMENTO'
        && ('alertaNaoCompareceuVisitaId' in depois)
        && visitaLigadaAoLeadDentroDoTurno(leadId, depois.alertaNaoCompareceuVisitaId);

      return ehRecepcionista() && (camposCompareceuOk || camposNaoCompareceuOk);
    }

    // Permite que uma recepcionista NÃO dona do Lead, mas dentro do
    // turno da visita, grave o espelho do reagendamento no Lead
    // (visita/ultimoAtendimento/atualizadoEm) — mesmo payload real
    // enviado por ReagendarVisitaAction.jsx. A dona já está coberta
    // por podeEditarLead(), sem depender de turno.
    function podeReagendarViaTurno(leadId, antes, depois) {
      let alterados = depois.diff(antes).affectedKeys();
      return ehRecepcionista()
          && alterados.hasOnly(['visita', 'ultimoAtendimento', 'atualizadoEm'])
          && ('visita' in depois)
          && ('id' in depois.visita)
          && visitaLigadaAoLeadDentroDoTurno(leadId, depois.visita.id);
    }

    // 'WHATSAPP_LIVRE' entrou nesta whitelist só para cobrir o
    // envio da mensagem de confirmação de visita pelo WhatsApp
    // (ConfirmarVisitaWhatsAppModal.jsx) — como ele sempre exige
    // 'visitaId' em dados e a prova de vínculo abaixo, um WhatsApp
    // Livre solto (sem visita, ex.: Dashboard/Leads/Kanban) nunca
    // passa por aqui; continua exigindo podeAgirNoLead() como já
    // era antes desta mudança.
    function eventoDeComparecimentoValido(leadId, dadosEvento) {
      return dadosEvento.tipo in ['VISITA', 'JORNADA', 'PENDENCIA', 'VISITA_CONFIRMACAO', 'VISITA_OBSERVACAO', 'WHATSAPP_LIVRE']
          && ('dados' in dadosEvento)
          && ('visitaId' in dadosEvento.dados)
          && visitaLigadaAoLeadDentroDoTurno(leadId, dadosEvento.dados.visitaId);
    }

    // ==========================================================
    // ATENDIMENTO COMPARTILHADO
    //
    // Qualquer recepcionista com conta ATIVA pode atender o lead de outra
    // consultora, mas SOMENTE por operações explícitas, cada uma com a lista
    // fechada de campos que pode gravar. Atender NÃO transfere a carteira:
    // responsavelUid / responsavel / consultora nunca mudam por aqui (quem
    // troca dono continua sendo só ehAutorizadoATransferirCarteira()).
    // Conta inativa (usuarios/{uid}.ativo == false) não executa nada daqui.
    //
    // AUTORIA: todo evento criado por este caminho precisa trazer o UID e o
    // nome do PRÓPRIO chamador (nunca o nome da titular do lead) e o instante
    // do servidor. O histórico é append-only: eventos nunca são editados nem
    // excluídos (allow update/delete: false) e visitas já baixadas
    // (COMPARECEU/NAO_COMPARECEU) nunca são regravadas por aqui.
    //
    // MÉTRICA: a matrícula conta para a TITULAR do lead (matricula.consultor == responsavel/consultora
    // do lead, validado aqui); quem realizou o fechamento fica em registradoPorUid/Nome (== chamador).
    // Operações (lead):  fechamento (etapa 4 -> 5, só o mapa 'matricula' novo),
    //   reagendamento (espelho 'visita'), comparecimento (etapa 3 -> 4, pelo
    //   botão do lead ou pela baixa da agenda) e não comparecimento.
    // Operações (visita): registrar atendimento, dar baixa (comparecimento) e
    //   reagendar. Observação e não fechamento são só EVENTOS.
    // ==========================================================

    function chamadorAtivo() {
      return dadosDoChamador().get('ativo', true) != false;
    }

    function recepcionistaAtiva() {
      return ehRecepcionista() && chamadorAtivo();
    }

    function etapaEh(dados, numero, texto) {
      return ('etapa' in dados) && (dados.etapa == numero || dados.etapa == texto);
    }

    function visitaDoLead(leadId, visitaId) {
      return get(/databases/$(database)/documents/visitas/$(visitaId)).data.leadId == leadId;
    }

    // A visita foi baixada (com este resultado) pelo PRÓPRIO chamador, nesta
    // sequência do app (a visita é atualizada antes do lead).
    function visitaBaixadaPorMim(leadId, visitaId, resultado) {
      let v = get(/databases/$(database)/documents/visitas/$(visitaId)).data;
      return v.leadId == leadId
          && v.get('comparecimento', '') == resultado
          && v.get('atendidoPor', '') == request.auth.uid;
    }

    function fechamentoCompartilhado(antes, depois, alterados) {
      return alterados.hasOnly(['etapa', 'ultimoAtendimento', 'matricula', 'atualizadoEm'])
          && etapaEh(antes, 4, '4')
          && depois.etapa == 5
          && !('matricula' in antes)
          && ('matricula' in depois)
          && depois.matricula is map
          && depois.matricula.keys().hasOnly(['confirmada', 'data', 'hora', 'consultor', 'observacao', 'plano',
                                              'dataInicio', 'dataVencimento', 'status',
                                              'registradoPorUid', 'registradoPorNome', 'atendimentoCompartilhado'])
          && depois.matricula.get('confirmada', false) == true
          && depois.matricula.get('status', '') == 'ATIVA'
          && depois.matricula.get('consultor', '') != ''
          && depois.matricula.get('consultor', '') in [valorOuVazio(antes, 'responsavel'), valorOuVazio(antes, 'consultora')]
          && depois.matricula.get('registradoPorUid', '') == request.auth.uid
          && depois.matricula.get('registradoPorNome', '') == nomeDoChamador();
    }

    function reagendamentoCompartilhado(leadId, antes, depois, alterados) {
      return alterados.hasOnly(['visita', 'ultimoAtendimento', 'atualizadoEm'])
          && ('visita' in depois)
          && depois.visita is map
          && depois.visita.keys().hasOnly(['id', 'data', 'hora', 'consultor', 'observacao'])
          && ('id' in depois.visita)
          && (!('visita' in antes) || !('id' in antes.visita) || antes.visita.id == depois.visita.id)
          && depois.visita.get('consultor', '') in [valorOuVazio(antes, 'responsavel'), valorOuVazio(antes, 'consultora')]
          && visitaDoLead(leadId, depois.visita.id);
    }

    // Botão "Registrar Comparecimento" do lead (etapa 3 -> 4).
    function comparecimentoDoLeadCompartilhado(antes, depois, alterados) {
      return alterados.hasOnly(['etapa', 'ultimoAtendimento', 'atualizadoEm'])
          && etapaEh(antes, 3, '3')
          && depois.etapa == 4;
    }

    // Baixa COMPARECEU pela agenda: a visita já foi baixada por mim.
    function comparecimentoDaVisitaCompartilhado(leadId, antes, depois, alterados) {
      return alterados.hasOnly(['etapa', 'ultimoAtendimento', 'alertaNaoCompareceu', 'ultimaVisitaId', 'atualizadoEm'])
          && etapaEh(antes, 3, '3')
          && depois.etapa == 4
          && depois.get('alertaNaoCompareceu', null) == false
          && ('ultimaVisitaId' in depois)
          && visitaBaixadaPorMim(leadId, depois.ultimaVisitaId, 'COMPARECEU');
    }

    // Baixa NAO_COMPARECEU pela agenda.
    function naoComparecimentoDaVisitaCompartilhado(leadId, antes, depois, alterados) {
      return alterados.hasOnly(['etapa', 'ultimoAtendimento', 'alertaNaoCompareceu', 'alertaNaoCompareceuEm',
                                'alertaNaoCompareceuVisitaId', 'pendenciaComercial', 'atualizadoEm'])
          && etapaEh(antes, 3, '3')
          && depois.etapa == 3
          && depois.get('alertaNaoCompareceu', null) == true
          && depois.get('pendenciaComercial', '') == 'NOVO_CONTATO_NAO_COMPARECIMENTO'
          && ('alertaNaoCompareceuVisitaId' in depois)
          && visitaBaixadaPorMim(leadId, depois.alertaNaoCompareceuVisitaId, 'NAO_COMPARECEU');
    }

    function podeAtenderLeadAlheio(leadId, antes, depois) {
      let alterados = depois.diff(antes).affectedKeys();
      return recepcionistaAtiva()
          && !propriedadeMudou(antes, depois)
          && ('atualizadoEm' in depois)
          && depois.atualizadoEm == request.time
          && (fechamentoCompartilhado(antes, depois, alterados)
              || reagendamentoCompartilhado(leadId, antes, depois, alterados)
              || comparecimentoDoLeadCompartilhado(antes, depois, alterados)
              || comparecimentoDaVisitaCompartilhado(leadId, antes, depois, alterados)
              || naoComparecimentoDaVisitaCompartilhado(leadId, antes, depois, alterados));
    }

    // Lead na fila de Recebidos (sem dono, etapa 0, não assumido): decisão antiga e mantida —
    // ninguém cria evento nele antes de assumir. Versão tolerante a campos ausentes.
    function leadEmFila(dados) {
      return dados.get('etapa', -1) == 0
          && dados.get('assumido', true) == false
          && leadSemResponsavel(dados);
    }

    // Evento do atendimento compartilhado: autor real (UID + nome) e instante do servidor.
    function eventoCompartilhadoValido(leadId, ev) {
      return recepcionistaAtiva()
          && !leadEmFila(get(/databases/$(database)/documents/leads/$(leadId)).data)
          && ev.get('tipo', '') in ['OBSERVACAO', 'MATRICULA', 'JORNADA', 'VISITA', 'PENDENCIA', 'NAO_FECHAMENTO']
          && ev.keys().hasOnly(['leadId', 'tipo', 'usuario', 'usuarioUid', 'descricao', 'dados', 'criadoEm'])
          && ev.get('leadId', '') == leadId
          && ev.get('usuarioUid', '') == request.auth.uid
          && ev.get('usuario', '') == nomeDoChamador()
          && ev.get('criadoEm', null) == request.time;
    }

    // ==========================================================
    // LEADS/{LEADID}
    // ==========================================================

    match /leads/{leadId} {

      allow get: if possoVerLead(resource.data);

      allow list: if possoVerLead(resource.data);

      allow create: if estaLogado()
                    && perfilDoChamador() in ['admin', 'coordenador', 'recepcionista']
                    && (ehAutorizadoATransferirCarteira()
                        || propriedadeInicialValida(request.resource.data));

      allow update: if podeEditarLead(leadId, resource.data, request.resource.data)
                    || podeAtualizarLeadViaComparecimento(leadId, resource.data, request.resource.data)
                    || podeReagendarViaTurno(leadId, resource.data, request.resource.data)
                    || podeAtenderLeadAlheio(leadId, resource.data, request.resource.data);

      // Exclusão permanente — restrita às duas identidades autorizadas
      // (mesma política da troca de dono). Antes bastava ser
      // admin/coordenador, o que permitia APAGAR um lead e RECRIÁ-LO
      // com outro responsável, contornando a restrição de
      // transferência. A regra de negócio "não excluir lead com visita
      // vinculada" é verificada no cliente (EventEngine.js, ANTES de
      // chamar deleteDoc) — aqui só decidimos QUEM pode excluir, nunca
      // QUANDO é seguro.
      allow delete: if ehAutorizadoATransferirCarteira();

      match /eventos/{eventoId} {

        // Decisão arquitetural aprovada:
        // - leitura de eventos de lead na fila Recebidos = ALLOW
        //   (usa possoVerLead, que inclui a fila para recepcionista)
        // - criação de evento em lead da fila, antes de assumir = DENY
        //   (usa podeAgirNoLead, que exige ser dono/admin/coordenador)

        allow read: if possoVerLead(
          get(/databases/$(database)/documents/leads/$(leadId)).data
        );

        // Segundo caminho: recepcionista cross-turno pode criar
        // SOMENTE eventos VISITA/JORNADA/PENDENCIA genuinamente
        // vinculados a uma visita real deste Lead, dentro do
        // próprio turno. Não abre leitura nem escrita geral da
        // timeline — o caminho normal (podeAgirNoLead) continua
        // exatamente como estava.
        allow create: if podeAgirNoLead(
          get(/databases/$(database)/documents/leads/$(leadId)).data
        ) || (
          ehRecepcionista() &&
          eventoDeComparecimentoValido(leadId, request.resource.data)
        ) || eventoCompartilhadoValido(leadId, request.resource.data);

        allow update: if false;

        allow delete: if false;

      }

    }

    // ==========================================================
    // FUNÇÕES DE VISITAS
    // ==========================================================

    function horarioDentroDoTurno(horaVisita, horaEntrada, horaSaida) {
      return horaEntrada <= horaSaida
        ? (horaVisita >= horaEntrada && horaVisita <= horaSaida)
        : (horaVisita >= horaEntrada || horaVisita <= horaSaida);
    }

    function dadosDoChamador() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function visitaDentroDoTurnoDoChamador(dadosVisita) {
      let usuario = dadosDoChamador();
      return ('hora' in dadosVisita)
          && ('horaEntrada' in usuario)
          && ('horaSaida' in usuario)
          && horarioDentroDoTurno(dadosVisita.hora, usuario.horaEntrada, usuario.horaSaida);
    }

    // Responsável pelo lead/visita (consultoraId == uid do
    // chamador) sempre pode VISUALIZAR a visita, independente do
    // turno. Isso é só leitura — não dá permissão de agir/
    // confirmar fora do turno (allow update abaixo não usa esta
    // função, continua exigindo visitaDentroDoTurnoDoChamador).
    function ehDonaDaVisita(dadosVisita) {
      return ('consultoraId' in dadosVisita)
          && dadosVisita.consultoraId == request.auth.uid;
    }

    // A visita pertence a um lead de que o chamador é titular (dono por UID ou por nome).
    // É o que permite à NOVA responsável de uma carteira transferida consultar as visitas
    // antigas do lead sem que o consultoraId delas (histórico) seja alterado.
    function visitaDeLeadDoChamador(dadosVisita) {
      return ('leadId' in dadosVisita)
          && souDonoDoLead(get(/databases/$(database)/documents/leads/$(dadosVisita.leadId)).data);
    }

    function podeVerVisita(dadosVisita) {
      return ehAdminOuCoordenador()
          || (ehRecepcionista() && (visitaDentroDoTurnoDoChamador(dadosVisita) || ehDonaDaVisita(dadosVisita)))
          || (recepcionistaAtiva() && visitaDeLeadDoChamador(dadosVisita));
    }

    // ATENDIMENTO COMPARTILHADO — visitas. Três operações, cada uma com lista fechada de campos.
    // Nunca altera consultoraId, leadId nem a marca da transferência; nunca regrava uma visita já baixada.
    function visitaSemBaixa(antes) {
      return antes.get('comparecimento', '') == '';
    }

    function registroDeAtendimentoDaVisita(antes, depois, alterados) {
      return alterados.hasOnly(['atendidoPor', 'atendidoPorNome', 'atendidoEm', 'observacao'])
          && visitaSemBaixa(antes)
          && antes.get('atendidoPor', '') in ['', request.auth.uid]
          && depois.get('atendidoPor', '') == request.auth.uid
          && depois.get('atendidoPorNome', '') == nomeDoChamador()
          && depois.get('atendidoEm', null) == request.time;
    }

    // O app (atualizarVisita) sempre regrava atualizadoEm com o instante do servidor: aceito, e só assim.
    function atualizadoEmDoServidor(alterados, depois) {
      return !('atualizadoEm' in alterados) || depois.atualizadoEm == request.time;
    }

    function baixaDaVisita(antes, depois, alterados) {
      return alterados.hasOnly(['comparecimento', 'status', 'pendenciaResolvida', 'atualizadoEm'])
          && atualizadoEmDoServidor(alterados, depois)
          && visitaSemBaixa(antes)
          && antes.get('atendidoPor', '') == request.auth.uid
          && depois.get('comparecimento', '') in ['COMPARECEU', 'NAO_COMPARECEU']
          && depois.get('status', '') == 'CONFIRMADA'
          && (depois.comparecimento == 'COMPARECEU'
              ? !('pendenciaResolvida' in alterados)
              : depois.get('pendenciaResolvida', true) == false);
    }

    function reagendamentoDaVisita(antes, depois, alterados) {
      return alterados.hasOnly(['data', 'hora', 'observacao', 'comparecimento', 'pendenciaResolvida', 'status', 'atualizadoEm'])
          && atualizadoEmDoServidor(alterados, depois)
          && antes.get('comparecimento', '') != 'COMPARECEU'
          && depois.get('comparecimento', 'x') == ''
          && depois.get('status', '') == 'AGENDADA'
          && depois.get('pendenciaResolvida', false) == true
          && depois.get('data', 0) is string
          && depois.get('hora', 0) is string;
    }

    function podeTratarVisitaCompartilhada(antes, depois) {
      let alterados = camposAlterados(antes, depois);
      return recepcionistaAtiva()
          && ('leadId' in antes)
          && autoriaValida(antes, depois)
          && (registroDeAtendimentoDaVisita(antes, depois, alterados)
              || baixaDaVisita(antes, depois, alterados)
              || reagendamentoDaVisita(antes, depois, alterados));
    }

    // ----------------------------------------------------------
    // AUDITORIA — CAMPOS DE AUTORIA
    //
    // Regra: quando um campo de autoria é alterado por esta
    // escrita (está em affectedKeys()), o valor gravado precisa
    // representar o próprio chamador (request.auth.uid /
    // nomeDoChamador()) — nunca outra pessoa. Se o campo NÃO está
    // sendo alterado por esta escrita, nada é exigido dele (assim
    // reagendamento, que não toca nesses campos, continua livre).
    //
    // confirmadoEm/atendidoEm: só podem ser gravados via
    // serverTimestamp() do SDK, que a Rule reconhece comparando o
    // valor final contra request.time (o timestamp real do
    // servidor no momento do commit) — não é uma comparação de
    // relógio/turno, é a forma padrão e documentada do Firestore
    // de confirmar que um campo foi realmente gravado com
    // serverTimestamp(). Não envolve timezone: request.time é um
    // Timestamp (UTC internamente), comparado por igualdade contra
    // outro Timestamp, sem conversão para hora local em nenhum
    // momento.
    // ----------------------------------------------------------

    function camposAlterados(antes, depois) {
      return depois.diff(antes).affectedKeys();
    }

    function autoriaValida(antes, depois) {
      let alterados = camposAlterados(antes, depois);

      let confirmadoPorOk =
        !('confirmadoPor' in alterados) || depois.confirmadoPor == request.auth.uid;

      let confirmadoPorNomeOk =
        !('confirmadoPorNome' in alterados) || depois.confirmadoPorNome == nomeDoChamador();

      let confirmadoEmOk =
        !('confirmadoEm' in alterados) || depois.confirmadoEm == request.time;

      let atendidoPorOk =
        !('atendidoPor' in alterados) || depois.atendidoPor == request.auth.uid;

      let atendidoPorNomeOk =
        !('atendidoPorNome' in alterados) || depois.atendidoPorNome == nomeDoChamador();

      let atendidoEmOk =
        !('atendidoEm' in alterados) || depois.atendidoEm == request.time;

      return confirmadoPorOk && confirmadoPorNomeOk && confirmadoEmOk
          && atendidoPorOk && atendidoPorNomeOk && atendidoEmOk;
    }

    // ==========================================================
    // VISITAS/{VISITAID}
    // ==========================================================

    match /visitas/{visitaId} {

      allow get: if podeVerVisita(resource.data);

      allow list: if podeVerVisita(resource.data);

      allow create: if estaLogado()
                    && perfilDoChamador() in ['admin', 'coordenador', 'recepcionista']
                    && podeAgirNoLead(
                         get(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data
                       );

      // consultoraId (dona da visita) e a marca ultimaTransferenciaEmMassaId
      // (que a reversão usa para saber QUAIS visitas a transferência mexeu)
      // só mudam pelos autorizados. Eles são
      // avaliados primeiro: 1 leitura de perfil por visita atualizada
      // (em vez de 2), o que importa porque a transferência/reversão
      // atualiza várias visitas na mesma transação.
      allow update: if (ehAutorizadoATransferirCarteira()
                        && autoriaValida(resource.data, request.resource.data))
                    || ((ehAdminOuCoordenador()
                         || (ehRecepcionista() && (visitaDentroDoTurnoDoChamador(resource.data) || ehDonaDaVisita(resource.data))))
                        && autoriaValida(resource.data, request.resource.data)
                        && !('consultoraId' in camposAlterados(resource.data, request.resource.data))
                        && !('ultimaTransferenciaEmMassaId' in camposAlterados(resource.data, request.resource.data)))
                    || podeTratarVisitaCompartilhada(resource.data, request.resource.data);

      allow delete: if false;

    }

    // ==========================================================
    // TRANSFERÊNCIAS EM MASSA — TRILHA DE AUDITORIA
    //
    // transferenciasEmMassa/{opId}        = a operação (a reversão tem ID
    //                                       fixo 'rev-<opId original>': só pode
    //                                       existir UMA por operação)
    // transferenciasEmMassa/{opId}/itens  = 1 item por lead
    //                                       efetivamente movido
    //
    // Leitura e escrita: somente as duas identidades autorizadas.
    // Ninguém apaga. A operação só muda enquanto 'em_andamento' e
    // só nos campos de progresso; ao finalizar fica imutável. O item
    // é imutável e só existe se o lead realmente mudou de dono na
    // MESMA transação (getAfter).
    // ==========================================================

    function operacaoMassa(opId) {
      return get(/databases/$(database)/documents/transferenciasEmMassa/$(opId)).data;
    }

    function reversaoDeOperacaoValida(nova) {
      let original = operacaoMassa(nova.reverteOpId);
      return original.tipo == 'transferencia'
          && original.status in ['concluida', 'concluida_com_pendencias']
          && original.destinoUid == nova.origemUid
          && original.origemUid == nova.destinoUid;
    }

    function valorOuNulo(dados, chave) {
      return chave in dados ? dados[chave] : null;
    }

    // 'anterior' = o responsável do lead ANTES desta transação (lido de
    // verdade; ausente vira null, como o serviço grava).
    function anteriorConfere(item, leadAntes) {
      return item.anterior is map
          && item.anterior.responsavelUid == valorOuNulo(leadAntes, 'responsavelUid')
          && item.anterior.responsavel == valorOuNulo(leadAntes, 'responsavel')
          && item.anterior.consultora == valorOuNulo(leadAntes, 'consultora');
    }

    // 'eventoId' = um evento TRANSFERENCIA REAL deste lead, criado na MESMA
    // transação (getAfter), desta operação, entre os mesmos responsáveis.
    function eventoDoItemConfere(opId, leadId, item) {
      let evento = getAfter(/databases/$(database)/documents/leads/$(leadId)/eventos/$(item.eventoId)).data;
      return item.eventoId is string
          && evento.tipo == 'TRANSFERENCIA'
          && evento.leadId == leadId
          && evento.dados.operacaoId == opId
          && evento.dados.responsavelAnteriorUid == item.deUid
          && evento.dados.novoResponsavelUid == item.paraUid;
    }

    function reversaoDeItemValida(op, leadId, antes, depois) {
      let itemOriginal = /databases/$(database)/documents/transferenciasEmMassa/$(op.reverteOpId)/itens/$(leadId);
      return exists(itemOriginal)
          && itemOriginalConfere(itemOriginal, op, antes, depois)
          && soCamposDeDonoMudaram(antes, depois);
    }

    // Leituras do item: operação (1), lead antes (1), lead depois (1) —
    // cada documento é lido UMA vez (let), em vez de várias chamadas.
    // As conferências de etapa e atualizadoEm usam dados já lidos; só o
    // item de uma REVERSÃO lê também o item da transferência original
    // (1 leitura, já feita pelo update do lead quando a origem é inativa).
    function itemCorrespondeATransferencia(opId, leadId, item) {
      let op = operacaoMassa(opId);
      let leadAntes = get(/databases/$(database)/documents/leads/$(leadId)).data;
      let leadDepois = getAfter(/databases/$(database)/documents/leads/$(leadId)).data;
      return op.status == 'em_andamento'
          && item.deUid == op.origemUid
          && item.paraUid == op.destinoUid
          && leadAntes.responsavelUid == item.deUid
          && leadDepois.responsavelUid == item.paraUid
          && leadDepois.ultimaTransferenciaEmMassaId == opId
          // etapa registrada no item = etapa real do lead (a reversão usa
          // isto para saber se o lead avançou no funil depois)
          && etapaDoLead(leadAntes) == item.etapa
          // o atualizadoEm do lead É o instante da transferência (o mesmo
          // do item.criadoEm): é o marco "lead intocado desde então"
          && ('atualizadoEm' in leadDepois)
          && leadDepois.atualizadoEm == request.time
          // B3 — os dados descritivos do item são CONFERIDOS com o que as
          // Rules enxergam, em vez de aceitos como o cliente enviou:
          && item.deNome == op.origemNome
          && item.paraNome == op.destinoNome
          && anteriorConfere(item, leadAntes)
          && eventoDoItemConfere(opId, leadId, item)
          && item.visitasAtualizadas is list
          // item de uma REVERSÃO: as mesmas proteções (lead de volta ao dono
          // anterior, não trabalhado depois, só campos de dono) valem
          // MESMO quando a origem está ATIVA — caso em que o update do
          // lead passa como transferência normal e não passaria pela
          // reversaoDeLeadValida()
          && (op.tipo != 'reversao'
              || reversaoDeItemValida(op, leadId, leadAntes, leadDepois));
    }

    // Os nomes gravados na operação são os do cadastro dos dois usuários
    // (2 leituras, só na CRIAÇÃO da operação).
    function nomesDaOperacaoConferem(dados) {
      let origem = get(/databases/$(database)/documents/usuarios/$(dados.origemUid)).data;
      let destino = get(/databases/$(database)/documents/usuarios/$(dados.destinoUid)).data;
      return dados.origemNome == origem.nome
          && dados.destinoNome == destino.nome;
    }

    function inteiroOuZero(dados, chave) {
      return chave in dados ? dados[chave] : 0;
    }

    // Contadores/estado final DECLARADOS pelo executor: coerentes entre si e
    // com o total previsto. As Rules NÃO conseguem contar os itens gravados
    // (não há agregação nem iteração), então "concluída" continua sendo uma
    // declaração: a fonte da verdade são os itens de auditoria.
    function contadoresCoerentes(dados) {
      let c = inteiroOuZero(dados, 'totalConcluido');
      let f = inteiroOuZero(dados, 'totalFalhas');
      let p = inteiroOuZero(dados, 'totalPulados');
      return c is int && f is int && p is int
          && c >= 0 && f >= 0 && p >= 0
          && c + f + p <= dados.totalPrevisto
          && (!('falhas' in dados) || dados.falhas.size() == f)
          && (!('pulados' in dados) || dados.pulados.size() == p)
          && (dados.status != 'concluida'
              || (c == dados.totalPrevisto && f == 0 && p == 0));
    }

    match /transferenciasEmMassa/{opId} {

      allow read: if ehAutorizadoATransferirCarteira();

      allow create: if ehAutorizadoATransferirCarteira()
                    && request.resource.data.executadoPorUid == request.auth.uid
                    && request.resource.data.status == 'em_andamento'
                    && request.resource.data.criadoEm == request.time
                    && request.resource.data.tipo in ['transferencia', 'reversao']
                    && request.resource.data.origemUid is string
                    && request.resource.data.destinoUid is string
                    && request.resource.data.origemUid != request.resource.data.destinoUid
                    // B3 — identidade e contagens declaradas conferidas na criação
                    && request.resource.data.executadoPorNome == nomeDoChamador()
                    && nomesDaOperacaoConferem(request.resource.data)
                    && request.resource.data.leadIds is list
                    && request.resource.data.leadIds.size() > 0
                    && request.resource.data.totalPrevisto == request.resource.data.leadIds.size()
                    && (request.resource.data.tipo == 'transferencia'
                          ? !('reverteOpId' in request.resource.data)
                          : (opId == 'rev-' + request.resource.data.reverteOpId
                             && reversaoDeOperacaoValida(request.resource.data)));

      allow update: if ehAutorizadoATransferirCarteira()
                    && resource.data.status == 'em_andamento'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'totalConcluido', 'totalFalhas', 'totalPulados',
                                   'falhas', 'pulados', 'visitasTardias',
                                   'finalizadoEm', 'finalizadoPorUid'])
                    && request.resource.data.status in ['em_andamento', 'concluida', 'concluida_com_pendencias']
                    && contadoresCoerentes(request.resource.data)
                    && (request.resource.data.status == 'em_andamento'
                        || (request.resource.data.finalizadoPorUid == request.auth.uid
                            && request.resource.data.finalizadoEm == request.time));

      allow delete: if false;

      match /itens/{leadId} {

        allow read: if ehAutorizadoATransferirCarteira();

        allow create: if ehAutorizadoATransferirCarteira()
                      && request.resource.data.executadoPorUid == request.auth.uid
                      && request.resource.data.criadoEm == request.time
                      && itemCorrespondeATransferencia(opId, leadId, request.resource.data);

        allow update, delete: if false;

      }

    }

  }
}
